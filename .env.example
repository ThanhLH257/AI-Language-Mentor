# ==============================================================================
# TEMPLATE CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN AI LANGUAGE MENTOR
# Sao chép file này thành .env và điền các khóa API tương ứng:
# ==============================================================================

# 1. Google Gemini API Key (Lấy tại: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Configuration (Lấy tại: Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

